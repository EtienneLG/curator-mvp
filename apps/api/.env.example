# Path to the SQLite database file (Prisma). Swap provider/URL to move to PostgreSQL later.
DATABASE_URL="file:./dev.db"

# Port the Fastify server listens on
PORT=3000

NODE_ENV=development

# Origin of the web app allowed to call this API via CORS
WEB_ORIGIN=http://localhost:5173

# Suggestion pipeline (DEC-016) — refine-time metadata lookup
# Gemini API key (https://ai.google.dev) — used only to classify content into
# { category, searchQuery }, never as a metadata source.
GEMINI_API_KEY=
# TMDB API key (MOVIE category)
TMDB_API_KEY=
# IGDB / Twitch app credentials (GAME category) — exchanged for a short-lived OAuth token
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Shared per-call timeout (ms) for every external suggestion call
SUGGESTION_TIMEOUT_MS=5000
